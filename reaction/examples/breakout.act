; Author: Sherman White Jr., email: subscribeandnotifyme@gmail.com c. 2026
; BREAKOUT - Atari 800, graphics mode 7+16 (160 by 96 in four colors, full screen; the score and the balls are drawn as pixels).
;
; The game asks first: P for paddles or K for the keyboard (the keyboard is the default: any other key, or
; Return, takes it).
;   Keyboard:  Z or , = left     X or . = right     Space = serve the ball
;   Paddle:    paddle 0 moves the bat; its button serves the ball
; Bricks and the bat are drawn straight into the screen memory (a byte holds 4 pixels), which is a lot faster
; than going through the operating system for every point.

INCLUDE "IO.ACT"
INCLUDE "GRAPHICS.ACT"
INCLUDE "MISC.ACT"
INCLUDE "SOUND.ACT"

DEFINE BRICKCOLS="20"           ; 20 bricks across, each 8 pixels (2 bytes) wide
DEFINE BRICKROWS="6"            ; and 6 rows, each 3 pixels high with 1 pixel between
DEFINE TOP="12"                 ; the first row of bricks starts 12 pixels down (the score is above)
DEFINE PADY="88"                ; the bat is on rows 88 and 89
DEFINE PADMAX="36"              ; the bat is 4 bytes (16 pixels) wide, and its place is a byte from 0 to 36
DEFINE PADREV="1"               ; 1 if turning the paddle to the right gives a smaller reading

CARD scr                        ; the screen memory
BYTE ARRAY brick(120)           ; 1 for each brick that is still there
BYTE ARRAY msk(4)=[$3F $CF $F3 $FC]     ; the bits of each of the 4 pixels in a byte, cleared
BYTE ARRAY mulv(4)=[64 16 4 1]          ; and what to multiply a color yb to put it in that pixel
BYTE usepad                     ; 1 if the paddle is used
BYTE snd                        ; frames the sound has still to run

PROC Pix(CARD x, CARD y, BYTE c)
 CARD a
 BYTE i, v
 a=scr+y*40+(x RSH 2)
 i=x&3
 v=Peek(a)
 v=(v&msk(i)) % (c*mulv(i))
 Poke(a, v)
RETURN

; a 2 by 2 ball at (x,y)
PROC Ball(CARD x, CARD y, BYTE c)
 CARD a
 BYTE i, m, cb, v
 i=x&3
 IF i<3 THEN                    ; both columns share a byte: change 2 bytes
  a=scr+y*40+(x RSH 2)
  m=msk(i)&msk(i+1)
  cb=c*(mulv(i)+mulv(i+1))
  v=Peek(a)
  Poke(a, (v&m) % cb)
  a==+40
  v=Peek(a)
  Poke(a, (v&m) % cb)
 ELSE
  Pix(x, y, c)
  Pix(x+1, y, c)
  Pix(x, y+1, c)
  Pix(x+1, y+1, c)
 FI
RETURN

PROC Beep(BYTE pitch, BYTE frames)
 Sound(0, pitch, 10, 8)
 snd=frames
RETURN

; the brick in column c and row r: 2 bytes wide and 3 rows high, in color 1 to 3 (0 takes it away)
PROC DrawBrick(BYTE c, BYTE r, BYTE col)
 CARD a, rr, cc
 BYTE k
 rr=r                           ; (a BYTE times 40 would wrap at 256)
 cc=c
 a=scr+(TOP+rr*4)*40+cc*2
 FOR k=1 TO 3
 DO
  PokeC(a, col*85*257)
  a==+40
 OD
RETURN

PROC DrawBat(BYTE pos, BYTE col)
 CARD a, v
 a=scr+PADY*40+pos
 v=col*85*257
 PokeC(a, v)
 PokeC(a+2, v)
 PokeC(a+40, v)
 PokeC(a+42, v)
RETURN

PROC ClearScreen()
 SetBlock(scr, 3840, 0)
RETURN

PROC Setup()
 Graphics(7+16)
 SetColor(4, 0, 0)              ; black
 IF (Peek($D014)&14)=0 THEN     ; PAL: the red of the PAL palette, else the NTSC one
  SetColor(0, 3, 2)
 ELSE
  SetColor(0, 3, 4)
 FI
 SetColor(1, 0, 14)             ; white
 SetColor(2, 0, 8)              ; grey
 scr=PeekC($58)
 ClearScreen()
RETURN

PROC Ask()
 BYTE k
 PrintE("BREAKOUT")
 PrintE("")
 PrintE("P for paddles or K for the keyboard")
 PrintE("(Return or any other key: keyboard)")
 PrintE("")
 PrintE("In the game, Space or Return serves.")
 k=KeyHit()
 WHILE k=0
 DO
  k=KeyHit()
 OD
 IF k=80 OR k=112 THEN
  usepad=1
 ELSE
  usepad=0
 FI
RETURN

; digits 0 to 9, 3 pixels wide and 5 high: one byte (3 bits) for each row
BYTE ARRAY font(50)=[7 5 5 5 7  2 6 2 2 7  7 1 7 4 7  7 1 7 1 7  5 5 7 1 1
                     7 4 7 1 7  7 4 7 5 7  7 1 1 1 1  7 5 7 5 7  7 5 7 1 7]

; the score in 4 digits at the top left
PROC ShowScore(CARD n)
 CARD d, x, p
 BYTE i, r, q, bits
 d=1000
 FOR i=0 TO 3
 DO
  q=n/d MOD 10
  x=2+i*4
  p=q*5
  FOR r=0 TO 4
  DO
   bits=font(p+r)
   Pix(x, 1+r, (bits&4)/4*2)
   Pix(x+1, 1+r, (bits&2)/2*2)
   Pix(x+2, 1+r, (bits&1)*2)
  OD
  d==/10
 OD
RETURN

; the balls that are left: small squares at the top right
PROC ShowLives(BYTE lives)
 BYTE i
 FOR i=0 TO 2
 DO
  IF i<lives THEN
   Ball(144+i*5, 2, 2)
  ELSE
   Ball(144+i*5, 2, 0)
  FI
 OD
RETURN

; wait for a key
PROC AnyKey()
 BYTE k
 k=KeyHit()
 WHILE k=0
 DO
  k=KeyHit()
 OD
RETURN

PROC Play()
 INT xb, yb, vx, vy
 CARD px, py, cx, cy, kx, ky, p, idx, score, hit
 BYTE pad, newpad, lives, left, state, ticks, k, kc, c, r, running

 FOR r=0 TO BRICKROWS-1
 DO
  FOR c=0 TO BRICKCOLS-1
  DO
   brick(r*BRICKCOLS+c)=1
   DrawBrick(c, r, (r+c) MOD 3+1)
  OD
 OD
 lives=3
 score=0
 left=BRICKCOLS*BRICKROWS
 pad=18
 DrawBat(pad, 1)
 state=0
 ticks=0
 px=0
 py=0
 vx=0
 vy=0
 xb=0
 yb=0
 running=1
 ShowScore(score)
 ShowLives(lives)

 WHILE running
 DO
  ticks==+1
  k=KeyHit()                    ; (it also empties the operating system's key buffer)

  ; ---- the bat
  newpad=pad
  IF usepad THEN
   p=Paddle(0)
   IF p>228 THEN p=228 FI
   IF PADREV THEN p=228-p FI
   newpad=p*PADMAX/228
  ELSE
   IF (Peek(53775)&4)=0 THEN    ; SKSTAT: a key is held down
    kc=Peek(53769)&63           ; KBCODE: which one
    IF (ticks&1)=0 THEN
     IF kc=$17 OR kc=$20 THEN   ; Z or ,
      IF newpad>0 THEN newpad==-1 FI
     FI
     IF kc=$16 OR kc=$22 THEN   ; X or .
      IF newpad<PADMAX THEN newpad==+1 FI
     FI
    FI
   FI
  FI
  IF newpad#pad THEN
   DrawBat(pad, 0)
   pad=newpad
   DrawBat(pad, 1)
  FI

  ; ---- the ball waiting on the bat, until it is served
  IF state=0 THEN
   Ball(px, py, 0)
   px=pad*4+7
   py=PADY-3
   xb=px*8
   yb=py*8
   Ball(px, py, 2)
   IF k=32 OR k=155 OR (usepad AND PTrig(0)=0) THEN
    state=1
    vy=-8
    IF Rand(2)=0 THEN vx=-6 ELSE vx=6 FI
   FI
  ELSE
   Ball(px, py, 0)
   xb==+vx
   yb==+vy
   ; the walls and the ceiling
   IF xb<0 THEN
    xb=0
    vx=-vx
    Beep(120, 3)
   FI
   IF xb>1256 THEN
    xb=1256
    vx=-vx
    Beep(120, 3)
   FI
   IF yb<0 THEN
    yb=0
    vy=-vy
    Beep(120, 3)
   FI
   px=xb/8
   py=yb/8
   ; the bricks: test the ball's top left pixel, then its bottom right one
   hit=0
   FOR k=0 TO 1
   DO
    cx=px+k
    cy=py+k
    IF hit=0 AND cy>=TOP THEN
     ky=(cy-TOP)/4
     IF ky<BRICKROWS AND ((cy-TOP)&3)#3 THEN
      kx=cx/8
      idx=ky*BRICKCOLS+kx
      IF brick(idx)#0 THEN
       brick(idx)=0
       DrawBrick(kx, ky, 0)
       left==-1
       score==+10
       vy=-vy
       hit=1
       Beep(40, 4)
       ShowScore(score)
      FI
     FI
    FI
   OD
   ; the bat
   IF vy>0 AND py+2>=PADY AND py<PADY+2 THEN
    IF px+2>pad*4 AND px<pad*4+16 THEN
     IF px+1<pad*4 THEN hit=0 ELSE hit=px+1-pad*4 FI
     vx=hit
     vx==-8
     vx==*2
     IF vx>=0 AND vx<3 THEN vx=3 FI
     IF vx<0 AND vx>-3 THEN vx=-3 FI
     vy=-8
     yb=(PADY-2)*8
     py=PADY-2
     Beep(80, 3)
    FI
   FI
   ; lost the ball
   IF py>=92 THEN
    lives==-1
    Beep(200, 30)
    state=0
    ShowLives(lives)
    IF lives=0 THEN running=0 FI
   ELSE
    Ball(px, py, 2)
   FI
  FI
  IF left=0 THEN running=0 FI

  IF snd>0 THEN
   snd==-1
   IF snd=0 THEN SndRst() FI
  FI
  Wait(1)
 OD

 SndRst()
 Graphics(0)
 IF left=0 THEN
  PrintE("YOU WIN!  Press a key.")
 ELSE
  PrintE("GAME OVER.  Press a key.")
 FI
 Print("Score ")
 PrintC(score)
 PrintE("")
 AnyKey()
RETURN

PROC Main()
 RandSeed(Ticks())
 DO
  Graphics(0)
  Ask()
  Setup()
  Play()
 OD
RETURN
