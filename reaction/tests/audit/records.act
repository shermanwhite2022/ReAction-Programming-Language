INCLUDE "IO.ACT"
TYPE rec=[BYTE b1,b2
 INT i1
 CARD c1,c2,c3
 BYTE b3]
DEFINE recordsize="5"
rec arec, brec=$8000
BYTE ARRAY idarray(1000)
rec POINTER newrecord
PROC main()
 BYTE reccount=[2]
 arec.b1=3
 arec.c2=arec.c1+1
 newrecord=idarray+(reccount*recordsize)
 newrecord.b2=7
RETURN